{
  "db": "data/huba.sqlite",
  "log_file": "logs/huba.log",
  "project_roots": [
    "",
    "AI"
  ],
  "poll_interval_sec": 120,
  "call": {
    "max_budget_usd": 0.5,
    "timeout_sec": 240
  },
  "auto_handover": {
    "enabled": true,
    "at_percent": 70,
    "idle_sec": 120
  },
  "auto_run": {
    "enabled": true,
    "allow": [
      "bash ~/projects/huba/install_update.sh --verify"
    ]
  },
  "confirm": {
    "enabled": true,
    "bot_token_env": "HUB_TELEGRAM_BOT_TOKEN",
    "chat_id_env": "HUB_TELEGRAM_CHAT_ID",
    "timeout_sec": 90
  },
  "projects": {
    "ai1": {},
    "codetrail": {},
    "dwork": {},
    "sdvi": {},
    "social": {},
    "tafalo5": {},
    "tcc": {},
    "tfl5": {}
  },
  "notify": {
    "file": "logs/notify.log",
    "macos_notification": true
  },
  "claude_cli": "claude",
  "claude_accounts": [
    {
      "name": "acc1",
      "launch": "claude"
    },
    {
      "name": "acc2",
      "config_dir": "~/.claude-acc2",
      "launch": "claude2"
    },
    {
      "name": "acc3",
      "config_dir": "~/.claude-acc3",
      "launch": "claude3"
    }
  ]
}
