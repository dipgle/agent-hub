# Copy to hub.env and chmod 600. Loaded by `hub` and `hubd` at startup because
# launchd does not read your shell profile. Values already present in the real
# environment always win, and only the KEY NAMES are ever logged.
#
#   cp hub.env.example hub.env && chmod 600 hub.env
#
# Telegram bot token from @BotFather
# HUB_TELEGRAM_TOKEN=123456789:AA...
#
# mailler API key (webmail → Settings → API keys)
# HUB_MAILLER_API_KEY=...
#
# Only needed if you expose the web console off loopback (see README);
# with it set, the UI asks for user "hub" + this password.
# HUB_WEB_PASSWORD=...
