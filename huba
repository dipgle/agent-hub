#!/usr/bin/env bash
# Thin wrapper so `./huba …` works from the huba directory without remembering the
# target path. Builds on first use, then execs the release binary.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
bin="$here/rust/target/release/huba"
if [[ ! -x "$bin" ]]; then
  echo "huba: building release binary (first run)…" >&2
  (cd "$here/rust" && cargo build --release --offline)
fi
exec "$bin" "$@"
