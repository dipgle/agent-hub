<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent: starts hubd at login and keeps it alive. hubd runs BOTH the
  poll loop and the web console (web.enabled in hub.config.json), so this is the
  only unit you need.

  Install:
    cp deploy/com.dipgle.hubd.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.dipgle.hubd.plist
  Status / logs:
    launchctl print gui/$(id -u)/com.dipgle.hubd | head -20
    tail -f ~/Documents/projects/AI/hub/logs/hubd.out
  Stop / uninstall:
    launchctl bootout gui/$(id -u)/com.dipgle.hubd
    rm ~/Library/LaunchAgents/com.dipgle.hubd.plist

  SECRETS: launchd does not read your shell profile. Put tokens in
  <hub>/hub.env (chmod 600) — hubd loads it at startup and logs only the KEY
  NAMES. Do not paste tokens into this file; it gets copied and backed up.

  MONEY: an unattended daemon triages on its own. `daily_budget_usd` in
  hub.config.json is the hard ceiling (default $5/day); when it is reached the
  loop stops triaging and tells you once.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dipgle.hubd</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/hanguyen/Documents/projects/AI/hub/rust/target/release/hubd</string>
  </array>

  <!-- Thư mục làm việc phải nằm NGOÀI ~/Documents. Đo 2026-08-10: để nó ở
       trong, tiến trình do launchd sinh ra treo cứng ngay tại `getcwd()` —
       `open$NOCANCEL` chờ một hộp thoại TCC không bao giờ hiện lên cho tiến
       trình nền. Không có log, không có mã lỗi, chỉ là một pid nằm im. -->
  <key>WorkingDirectory</key>
  <string>/Users/hanguyen/Library/Application Support/hub</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- gh, claude, git and sqlite3 live outside launchd's default PATH -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/Users/hanguyen/.npm-global/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <!-- Thư mục làm việc không còn nằm trong repo, nên hub không thể tìm
         `hub.config.json` bằng cách đi ngược lên từ cwd nữa. Chỉ thẳng đường:
         thiếu dòng này, hub rơi về cấu hình mặc định và ghi
         `adapter_skipped reason=disabled` — chạy, nhưng không nối với phòng
         chat nào cả (đo 2026-08-10). -->
    <key>HUB_CONFIG</key>
    <string>/Users/hanguyen/Documents/projects/AI/hub/hub.config.json</string>

    <key>HUB_LOG_LEVEL</key>
    <string>info</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <!-- Do not fight the user for CPU; triage is a background chore. -->
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>

  <!--
    Log NGOÀI ~/Documents.

    Đo 2026-08-09: bootstrap xong, `launchctl list` báo `- 78 com.dipgle.hubd`,
    `runs = 105`, và KHÔNG có một dòng nào của bản launchd trong log — tức
    launchd chưa spawn nổi chứ không phải hubd thoát (hubd chỉ trả 70/3/1).
    Mọi thứ khác đều đúng: plist hợp lệ, binary có quyền chạy, không đăng ký cũ
    kẹt, và bỏ khoá pid 70 giây vẫn không dựng lên.

    Thứ còn lại là TCC: `~/Documents` là thư mục macOS bảo vệ, và launchd phải
    MỞ ĐƯỢC StandardOutPath trước khi chạy chương trình. Không mở được thì hỏng
    ở đúng bước dựng stdio, và đó là `EX_CONFIG` (78). `~/Library/Logs` không bị
    bảo vệ, nên log ra đó.

    Nếu vẫn 78 sau khi đổi: cấp Full Disk Access cho chính binary
    (System Settings → Privacy & Security → Full Disk Access → thêm
    …/hub/rust/target/release/hubd), vì WorkingDirectory vẫn nằm trong Documents.
  -->
  <key>StandardOutPath</key>
  <string>/Users/hanguyen/Library/Logs/hubd.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/hanguyen/Library/Logs/hubd.err</string>
</dict>
</plist>
